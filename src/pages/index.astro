import childProcess from "child_process";

const hash = childProcess.execSync("git rev-parse --short HEAD").toString().trim();
let getDate = childProcess.execSync(`git show -s --format="%ci" ${hash}`).toString().slice(0,10);
const options = { year: "numeric", month: "long", day: "numeric" };
getDate = new Date(getDate).toLocaleDateString("en-CA", options);

